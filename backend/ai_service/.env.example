# Copia a backend/ai_service/.env y rellena desde Supabase.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Opcional si usas JWT legacy HS256 (Supabase ya no lo muestra por defecto).
SUPABASE_JWT_SECRET=
# Opcional si usas claves asimétricas; por defecto se deriva de SUPABASE_URL.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Ollama debe ejecutarse en el servidor, nunca en el navegador.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Opcional: modelo multimodal para analizar fotos (ej. llava:7b, qwen2.5vl:3b).
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=25

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_HOST=127.0.0.1
AI_PORT=8001
