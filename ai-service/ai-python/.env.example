# =========================================================
# Centinela · ai-python (FastAPI + scikit-learn + gateway)
# Copia a ai-service/ai-python/.env. Los secretos viven solo aquí.
# =========================================================

# Supabase (opcional para el modo demostración con datos sintéticos).
# Usa la service_role SOLO en el servidor; nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Si true, todos los endpoints exigen JWT de Supabase.
# Déjalo en false para probar en local sin login.
AI_AUTH_REQUIRED=false

# Datos de prueba: si Supabase no está configurado o hay menos de
# SYNTHETIC_MIN_INCIDENTS registros, se usa un dataset sintético marcado.
ALLOW_SYNTHETIC=true
SYNTHETIC_MIN_INCIDENTS=24
SYNTHETIC_SEED=42
DEMO_ORGANIZATION_ID=00000000-0000-4000-d000-000000000001

# Ollama local. Si no está activo, se usan resúmenes deterministas.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=20

# Servicio Java DL4J (clasificación/priorización).
JAVA_AI_URL=http://127.0.0.1:8003

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
AI_HOST=127.0.0.1
AI_PORT=8001
