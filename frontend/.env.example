# Copia este archivo como .env en frontend/ y llena tus valores.
# Solo las variables con prefijo VITE_ se exponen al navegador.

# Supabase (proyecto → Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox — token público de URL (pk...). RESTRÍNGELO por URL/domains en
# https://account.mapbox.com/access-tokens/ (no es un secreto, pero sin
# restringir cualquiera podría gastar tu cuota).
VITE_MAPBOX_TOKEN=
