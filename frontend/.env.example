# =========================================================
# Centinela · Frontend (Vite)
# Copia este archivo como frontend/.env y completa los valores.
# Solo las variables VITE_* llegan al navegador: nunca pongas
# secretos (service_role, JWT secret, contraseñas) aquí.
# =========================================================

# Supabase → Project Settings → API (clave pública anon/publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox → Access tokens. Token público de URL (empieza por "pk.").
# Restríngelo por dominio en https://account.mapbox.com/access-tokens/
# Si lo dejas vacío, el mapa usa Leaflet + OpenStreetMap en modo local.
VITE_MAPBOX_TOKEN=

# Gateway de IA local (FastAPI). Si está vacío, el panel de IA se oculta.
VITE_AI_API_URL=http://127.0.0.1:8001
