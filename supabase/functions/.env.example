# Secretos de la Edge Function create-user (SÍ se sube al repo).
# Copia este archivo como .env (gitignored) o configura los secretos con:
#   supabase secrets set --env-file supabase/functions/.env

# URL del proyecto (se inyecta sola en Supabase, pero se declara por claridad)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública / anon: se usa para validar el JWT del administrador que llama
SUPABASE_ANON_KEY=eyJ...

# Service role: SOLO aquí, nunca en el frontend.
# Clave clásica: service_role...   |   Clave nueva: sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_SECRET_KEY=sb_secret_...